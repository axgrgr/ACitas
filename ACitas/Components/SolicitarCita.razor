@page "/solicitar-cita"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using ACitas.Data
@using ACitas.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ACitasContext> DbFactory

<PageTitle>Solicitar cita</PageTitle>

<div class="container mt-4" style="max-width: 760px;">
    <h1>Solicitar una cita</h1>
    <p>Completa tus datos y elige el servicio y horario que prefieres.</p>

    @if (!string.IsNullOrWhiteSpace(mensajeExito))
    {
        <div class="alert alert-success">
            @mensajeExito
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="alert alert-danger">
            @mensajeError
        </div>
    }

    @if (cargando)
    {
        <p>Cargando servicios...</p>
    }
    else if (servicios.Count == 0)
    {
        <div class="alert alert-warning">
            Aún no hay servicios activos. Primero agrega servicios a la base de datos.
        </div>
    }
    else
    {
        <EditForm Model="formulario" OnValidSubmit="GuardarCita">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Nombre completo</label>
                <InputText class="form-control" @bind-Value="formulario.Nombre" />
                <ValidationMessage For="@(() => formulario.Nombre)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Teléfono de WhatsApp</label>
                <InputText class="form-control" @bind-Value="formulario.Telefono" />
                <ValidationMessage For="@(() => formulario.Telefono)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Correo (opcional)</label>
                <InputText class="form-control" @bind-Value="formulario.Correo" />
                <ValidationMessage For="@(() => formulario.Correo)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Servicio</label>
                <InputSelect class="form-select"
                             @bind-Value="formulario.ServicioId"
                             @bind-Value:after="ActualizarDisponibilidad">
                    <option value="0">Selecciona un servicio</option>
                    @foreach (var servicio in servicios)
                    {
                        <option value="@servicio.ServicioId">
                            @servicio.Nombre — @servicio.DuracionMinutos min
                        </option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => formulario.ServicioId)" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Fecha</label>
                <InputDate class="form-control"
                           @bind-Value="formulario.Fecha"
                           @bind-Value:after="ActualizarDisponibilidad" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Hora disponible</label>
                <InputSelect class="form-select" @bind-Value="formulario.Hora">
                    <option value="">Selecciona una hora</option>
                    @foreach (var horaDisponible in horasDisponibles)
                    {
                        <option value="@horaDisponible">@horaDisponible</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => formulario.Hora)" />

                @if (!string.IsNullOrWhiteSpace(mensajeDisponibilidad))
                {
                    <small class="text-muted">@mensajeDisponibilidad</small>
                }
            </div>

            <div class="mb-3">
                <label class="form-label">Comentario (opcional)</label>
                <InputTextArea class="form-control" @bind-Value="formulario.Comentario" />
            </div>

            <button class="btn btn-primary" type="submit" disabled="@guardando">
                @(guardando ? "Enviando..." : "Solicitar cita")
            </button>
        </EditForm>
    }
</div>

@code {
    private List<Servicio> servicios = new();
    private SolicitudForm formulario = new();
    private bool cargando = true;
    private bool guardando;
    private string? mensajeExito;
    private string? mensajeError;

    private List<string> horasDisponibles = new();
    private string? mensajeDisponibilidad;



    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        servicios = await db.Servicios
            .Where(s => s.Activo)
            .OrderBy(s => s.Nombre)
            .ToListAsync();

        cargando = false;
    }

    private async Task ActualizarDisponibilidad()
    {
        horasDisponibles.Clear();
        formulario.Hora = string.Empty;
        mensajeDisponibilidad = null;

        if (formulario.ServicioId <= 0)
        {
            mensajeDisponibilidad = "Selecciona primero un servicio.";
            return;
        }

        if (formulario.Fecha.Date < DateTime.Today)
        {
            mensajeDisponibilidad = "Selecciona una fecha de hoy en adelante.";
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var servicio = await db.Servicios
                .AsNoTracking()
                .FirstOrDefaultAsync(s =>
                    s.ServicioId == formulario.ServicioId && s.Activo);

            if (servicio is null || servicio.DuracionMinutos <= 0)
            {
                mensajeDisponibilidad = "El servicio seleccionado no está disponible.";
                return;
            }

            byte diaSemana = formulario.Fecha.DayOfWeek == DayOfWeek.Sunday
                ? (byte)7
                : (byte)formulario.Fecha.DayOfWeek;

            var bloques = await db.Horarios
                .AsNoTracking()
                .Where(h => h.Activo && h.DiaSemana == diaSemana)
                .OrderBy(h => h.HoraInicio)
                .ToListAsync();

            if (bloques.Count == 0)
            {
                mensajeDisponibilidad = "No hay horarios activos para ese día.";
                return;
            }

            var inicioDia = formulario.Fecha.Date;
            var finDia = inicioDia.AddDays(1);

            var citasDelDia = await db.Citas
                .AsNoTracking()
                .Include(c => c.Servicio)
                .Where(c =>
                    c.FechaHoraInicio >= inicioDia &&
                    c.FechaHoraInicio < finDia &&
                    (c.Estado == "Pendiente" ||
                     c.Estado == "Aceptada" ||
                     c.Estado == "Pospuesta"))
                .ToListAsync();

            foreach (var bloque in bloques)
            {
                var hora = bloque.HoraInicio;

                while (hora.AddMinutes(servicio.DuracionMinutos) <= bloque.HoraFin)
                {
                    var inicioCandidato = formulario.Fecha.Date.Add(hora.ToTimeSpan());
                    var finCandidato = inicioCandidato.AddMinutes(servicio.DuracionMinutos);

                    bool yaPaso = inicioCandidato <= DateTime.Now;

                    bool seCruzaConCita = citasDelDia.Any(c =>
                        inicioCandidato <
                            c.FechaHoraInicio.AddMinutes(c.Servicio.DuracionMinutos) &&
                        c.FechaHoraInicio < finCandidato);

                    if (!yaPaso && !seCruzaConCita)
                    {
                        horasDisponibles.Add(hora.ToString("HH:mm"));
                    }

                    hora = hora.AddMinutes(servicio.DuracionMinutos);
                }
            }

            horasDisponibles = horasDisponibles
                .Distinct()
                .OrderBy(h => TimeOnly.Parse(h))
                .ToList();

            mensajeDisponibilidad = horasDisponibles.Count == 0
                ? "No hay horas disponibles para esa fecha y servicio."
                : "Selecciona una hora disponible.";
        }
        catch
        {
            mensajeDisponibilidad =
                "No se pudieron cargar los horarios. Revisa la conexión a la base de datos.";
        }
    }





    private async Task GuardarCita()
    {
        mensajeError = null;
        mensajeExito = null;

        if (formulario.ServicioId <= 0)
        {
            mensajeError = "Selecciona un servicio.";
            return;
        }

        if (!TimeSpan.TryParse(formulario.Hora, out var hora))
        {
            mensajeError = "Escribe una hora válida.";
            return;
        }

        var fechaHora = formulario.Fecha.Date.Add(hora);

        if (fechaHora <= DateTime.Now)
        {
            mensajeError = "Selecciona una fecha y hora futuras.";
            return;
        }

        guardando = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var cliente = await db.Clientes
                .FirstOrDefaultAsync(c => c.Telefono == formulario.Telefono.Trim());

            if (cliente is null)
            {
                cliente = new Cliente
                {
                    Nombre = formulario.Nombre.Trim(),
                    Telefono = formulario.Telefono.Trim(),
                    Correo = string.IsNullOrWhiteSpace(formulario.Correo)
                        ? null
                        : formulario.Correo.Trim(),
                    FechaRegistro = DateTime.Now,
                    Activo = true
                };

                db.Clientes.Add(cliente);
                await db.SaveChangesAsync();
            }

            var ahora = DateTime.Now;

            var cita = new Cita
            {
                Folio = Guid.NewGuid(),
                ClienteId = cliente.ClienteId,
                NombreCliente = formulario.Nombre.Trim(),
                CorreoCliente = string.IsNullOrWhiteSpace(formulario.Correo)
                    ? null
                    : formulario.Correo.Trim(),
                ServicioId = formulario.ServicioId,
                FechaHoraInicio = fechaHora,
                Estado = "Pendiente",
                ComentarioCliente = string.IsNullOrWhiteSpace(formulario.Comentario)
                    ? null
                    : formulario.Comentario.Trim(),
                FechaCreacion = ahora,
                FechaActualizacion = ahora
            };

            db.Citas.Add(cita);
            await db.SaveChangesAsync();

            mensajeExito = $"Solicitud enviada. Tu folio es: {cita.Folio}";
            formulario = new SolicitudForm();
        }
        catch (Exception)
        {
            mensajeError = "No se pudo guardar la cita. Revisa la conexión a la base de datos.";
        }
        finally
        {
            guardando = false;
        }
    }

    private sealed class SolicitudForm
    {
        [Required(ErrorMessage = "Escribe tu nombre.")]
        public string Nombre { get; set; } = string.Empty;

        [Required(ErrorMessage = "Escribe tu teléfono.")]
        [Phone(ErrorMessage = "Escribe un teléfono válido.")]
        public string Telefono { get; set; } = string.Empty;

        [EmailAddress(ErrorMessage = "Escribe un correo válido.")]
        public string? Correo { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Selecciona un servicio.")]
        public int ServicioId { get; set; }

        [Required(ErrorMessage = "Escribe la hora.")]
        public string Hora { get; set; } = string.Empty;

        public DateTime Fecha { get; set; } = DateTime.Today.AddDays(1);

        public string? Comentario { get; set; }
    }
}
