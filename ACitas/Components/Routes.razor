@using ACitas.Components.Account.Shared

@* agregado por mi el using (guillen) *@
@using Microsoft.AspNetCore.Components.Authorization

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData"
                            DefaultLayout="@typeof(Layout.MainLayout)">
            <NotAuthorized>
                <p>Necesitas iniciar sesión para administrar las citas.</p>
                <a href="/Identity/Account/Login?ReturnUrl=/admin/citas">Iniciar sesión</a>
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
</Router>
