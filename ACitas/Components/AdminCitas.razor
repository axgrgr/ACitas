@page "/admin/citas"
@rendermode InteractiveServer
@using ACitas.Data
@using ACitas.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ACitasContext> DbFactory

    @* agregado por mi (guillen) *@
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]


<PageTitle>Administrar citas</PageTitle>

<div class="container mt-4">
    <h1>Administrar citas</h1>
    <p>Revisa las solicitudes y cambia su estado.</p>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert alert-info">@mensaje</div>
    }

    @if (cargando)
    {
        <p>Cargando citas...</p>
    }
    else if (citas.Count == 0)
    {
        <div class="alert alert-secondary">Todavía no hay citas registradas.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Fecha y hora</th>
                        <th>Cliente</th>
                        <th>Teléfono</th>
                        <th>Servicio</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cita in citas)
                    {
                        <tr>
                            <td>@cita.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@cita.NombreCliente</td>
                            <td>@cita.Cliente.Telefono</td>
                            <td>@cita.Servicio.Nombre</td>
                            <td>@cita.Estado</td>
                            <td>
                                @if (cita.Estado == "Pendiente" || cita.Estado == "Pospuesta")
                                {
                                    <button class="btn btn-sm btn-success"
                                            @onclick='() => CambiarEstado(cita.CitaId, "Aceptada")'>
                                        Aceptar
                                    </button>

                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick='() => CambiarEstado(cita.CitaId, "Rechazada")'>
                                        Rechazar
                                    </button>

                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => PrepararPosponer(cita)">
                                        Posponer
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (citaParaPosponerId.HasValue)
    {
        <div class="card p-3 mt-4" style="max-width: 500px;">
            <h4>Proponer otra fecha</h4>

            <label class="form-label">Nueva fecha</label>
            <InputDate class="form-control mb-3"
                       @bind-Value="nuevaFecha"
                       @bind-Value:after="CargarHorasPosponer" />

            <label class="form-label">Nueva hora disponible</label>
            <InputSelect class="form-select mb-3" @bind-Value="nuevaHora">
                <option value="">Selecciona una hora</option>
                @foreach (var hora in horasPosponerDisponibles)
                {
                    <option value="@hora">@hora</option>
                }
            </InputSelect>

            @if (!string.IsNullOrWhiteSpace(mensajeHorasPosponer))
            {
                <div class="form-text mb-3">@mensajeHorasPosponer</div>
            }

            <button class="btn btn-primary me-2" @onclick="GuardarPosposicion">
                Guardar propuesta
            </button>
            <button class="btn btn-secondary" @onclick="CancelarPosponer">
                Cancelar
            </button>
        </div>
    }
</div>

@code {
    private List<Cita> citas = new();
    private bool cargando = true;
    private string? mensaje;

    private int? citaParaPosponerId;
    private DateTime nuevaFecha = DateTime.Today.AddDays(1);
    private string nuevaHora = "09:00";

    private List<string> horasPosponerDisponibles = new();
    private string? mensajeHorasPosponer;



    protected override async Task OnInitializedAsync()
    {
        await CargarCitas();
    }

    private async Task CargarCitas()
    {
        cargando = true;

        await using var db = await DbFactory.CreateDbContextAsync();

        citas = await db.Citas
            .Include(c => c.Cliente)
            .Include(c => c.Servicio)
            .OrderBy(c => c.FechaHoraInicio)
            .ToListAsync();

        cargando = false;
    }

    private async Task CambiarEstado(int citaId, string estado)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var cita = await db.Citas
            .Include(c => c.Cliente)
            .FirstOrDefaultAsync(c => c.CitaId == citaId);

        if (cita is null)
        {
            mensaje = "No se encontró la cita.";
            return;
        }

        estado = estado.Trim();
    
        cita.Estado = estado;
        cita.FechaActualizacion = DateTime.Now;

        var texto = estado == "Aceptada"
            ? $"Hola {cita.NombreCliente}, tu cita para el {cita.FechaHoraInicio:dd/MM/yyyy HH:mm} fue aceptada."
            : $"Hola {cita.NombreCliente}, tu cita para el {cita.FechaHoraInicio:dd/MM/yyyy HH:mm} fue rechazada.";

        db.Notificaciones.Add(new Notificacione
        {
            CitaId = cita.CitaId,
            Canal = "WhatsApp",
            Destino = cita.Cliente.Telefono,
            Mensaje = texto,
            EstadoEnvio = "Pendiente",
            FechaCreacion = DateTime.Now
        });

        await db.SaveChangesAsync();

        mensaje = $"Cita actualizada a: {estado}. Aviso registrado como pendiente.";
        await CargarCitas();
    }

    private async Task PrepararPosponer(Cita cita)
    {
        citaParaPosponerId = cita.CitaId;
        nuevaFecha = cita.FechaHoraInicio.Date;
        nuevaHora = string.Empty;
        mensaje = null;

        await CargarHorasPosponer();
    }

    private async Task GuardarPosposicion()
    {
        if (!citaParaPosponerId.HasValue ||
            !TimeSpan.TryParse(nuevaHora, out var hora))
        {
            mensaje = "Selecciona una fecha y hora válidas.";
            return;
        }

        if (!horasPosponerDisponibles.Contains(nuevaHora))
        {
            mensaje = "Selecciona una hora disponible del horario configurado.";
            return;
        }

        var fechaPropuesta = nuevaFecha.Date.Add(hora);

        if (fechaPropuesta <= DateTime.Now)
        {
            mensaje = "La nueva fecha debe estar en el futuro.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var cita = await db.Citas
            .Include(c => c.Cliente)
            .FirstOrDefaultAsync(c => c.CitaId == citaParaPosponerId.Value);

        if (cita is null)
        {
            mensaje = "No se encontró la cita.";
            citaParaPosponerId = null;
            return;
        }

        cita.FechaHoraInicio = fechaPropuesta;
        cita.Estado = "Pospuesta";
        cita.FechaActualizacion = DateTime.Now;
        cita.NotaDueno = "Se propuso una nueva fecha al cliente.";

        var texto =
            $"Hola {cita.NombreCliente}, tu cita fue pospuesta. " +
            $"La nueva fecha y hora propuesta es {fechaPropuesta:dd/MM/yyyy HH:mm}.";

        db.Notificaciones.Add(new Notificacione
        {
            CitaId = cita.CitaId,
            Canal = "WhatsApp",
            Destino = cita.Cliente.Telefono,
            Mensaje = texto,
            EstadoEnvio = "Pendiente",
            FechaCreacion = DateTime.Now
        });

        await db.SaveChangesAsync();

        citaParaPosponerId = null;
        mensaje = "Nueva fecha guardada. Aviso registrado como pendiente.";
        await CargarCitas();
    }

    private void CancelarPosponer()
    {
        citaParaPosponerId = null;
        mensaje = null;
    }



    private async Task CargarHorasPosponer()
    {
        horasPosponerDisponibles.Clear();
        nuevaHora = string.Empty;
        mensajeHorasPosponer = null;

        if (!citaParaPosponerId.HasValue)
            return;

        if (nuevaFecha.Date < DateTime.Today)
        {
            mensajeHorasPosponer = "Selecciona una fecha de hoy en adelante.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var citaActual = await db.Citas
            .AsNoTracking()
            .Include(c => c.Servicio)
            .FirstOrDefaultAsync(c => c.CitaId == citaParaPosponerId.Value);

        if (citaActual is null)
        {
            mensajeHorasPosponer = "No se encontró la cita.";
            return;
        }

        byte diaSemana = nuevaFecha.DayOfWeek == DayOfWeek.Sunday
            ? (byte)7
            : (byte)nuevaFecha.DayOfWeek;

        var bloques = await db.Horarios
            .AsNoTracking()
            .Where(h => h.Activo && h.DiaSemana == diaSemana)
            .OrderBy(h => h.HoraInicio)
            .ToListAsync();

        if (bloques.Count == 0)
        {
            mensajeHorasPosponer = "No hay horarios activos para ese día.";
            return;
        }

        var inicioDia = nuevaFecha.Date;
        var finDia = inicioDia.AddDays(1);

        var citasOcupadas = await db.Citas
            .AsNoTracking()
            .Include(c => c.Servicio)
            .Where(c =>
                c.CitaId != citaActual.CitaId &&
                c.FechaHoraInicio >= inicioDia &&
                c.FechaHoraInicio < finDia &&
                (c.Estado == "Pendiente" ||
                 c.Estado == "Aceptada" ||
                 c.Estado == "Pospuesta"))
            .ToListAsync();

        foreach (var bloque in bloques)
        {
            var hora = bloque.HoraInicio;

            while (hora.AddMinutes(citaActual.Servicio.DuracionMinutos)
                   <= bloque.HoraFin)
            {
                var inicioPropuesto = nuevaFecha.Date.Add(hora.ToTimeSpan());
                var finPropuesto = inicioPropuesto.AddMinutes(
                    citaActual.Servicio.DuracionMinutos);

                bool yaPaso = inicioPropuesto <= DateTime.Now;

                bool ocupado = citasOcupadas.Any(c =>
                    inicioPropuesto <
                        c.FechaHoraInicio.AddMinutes(c.Servicio.DuracionMinutos) &&
                    c.FechaHoraInicio < finPropuesto);

                if (!yaPaso && !ocupado)
                    horasPosponerDisponibles.Add(hora.ToString("HH:mm"));

                hora = hora.AddMinutes(citaActual.Servicio.DuracionMinutos);
            }
        }

        horasPosponerDisponibles = horasPosponerDisponibles
            .Distinct()
            .OrderBy(h => TimeOnly.Parse(h))
            .ToList();

        mensajeHorasPosponer = horasPosponerDisponibles.Count == 0
            ? "No hay horas disponibles para esa fecha."
            : "Selecciona una hora disponible.";
    }








}